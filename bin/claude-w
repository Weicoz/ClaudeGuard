#!/usr/bin/env python3
"""Compatibility entry point for the integrated Claude-W commands."""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from src.window_manager import main

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'窗口管理失败：{exc}', file=sys.stderr)
        raise SystemExit(1)
